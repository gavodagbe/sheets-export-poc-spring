# Copier en .env et renseigner (docker-compose le charge automatiquement).
# Identifiants d'un client OAuth "Web application" (console Google Cloud).
# Authorized redirect URI à déclarer côté Google :
#     http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
